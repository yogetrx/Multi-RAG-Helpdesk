
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/src
ENV PIP_NO_CACHE_DIR=1

# Install CPU-only PyTorch from the official PyTorch CPU index.
RUN python -m pip install --no-cache-dir \
    torch==2.15.0+cpu \
    --index-url https://download.pytorch.org/whl/cpu

# Copy the pinned dependency list.
COPY requirements-lock.txt .

# Install remaining pinned dependencies without reinstalling PyTorch.
RUN grep -v '^torch==' requirements-lock.txt > /tmp/requirements-lock.txt \
    && python -m pip install --no-cache-dir \
       -r /tmp/requirements-lock.txt

# Copy application source and knowledge-base data.
COPY src/ ./src/
COPY data/ ./data/

EXPOSE 8000

CMD ["uvicorn", "helpdesk.main:app", "--host", "0.0.0.0", "--port", "8000"]
