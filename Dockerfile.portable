
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/src
ENV PIP_NO_CACHE_DIR=1

# Install CPU-only PyTorch first
RUN pip install torch==2.15.0+cpu \
    --index-url https://download.pytorch.org/whl/cpu

# Install pinned dependencies without reinstalling PyTorch
COPY requirements-lock.txt .
RUN grep -v '^torch==' requirements-lock.txt > /tmp/requirements-lock.txt \
    && pip install -r /tmp/requirements-lock.txt

COPY src/ ./src/
COPY data/ ./data/

EXPOSE 8000

CMD ["uvicorn", "helpdesk.main:app", "--host", "0.0.0.0", "--port", "8000"]
